{#
/**
 * @file
 * Theme override for status messages.
 *
 * Available variables:
 * - message_list: Messages grouped by type.
 * - status_headings: Headings keyed by type.
 * - attributes: Remaining HTML attributes for the wrapping element.
 */
#}
<div data-drupal-messages class="messages-list">
  {% for type, messages in message_list %}
    {%
      set classes = [
        'messages',
        'messages--' ~ type,
        'alert',
        type == 'status' ? 'alert-success',
        type == 'warning' ? 'alert-warning',
        type == 'error' ? 'alert-error',
        type == 'info' ? 'alert-info',
      ]
    %}
    <div role="{{ type == 'error' ? 'alert' : 'status' }}" aria-label="{{ status_headings[type] }}"{{ create_attribute().addClass(classes) }}>
      {% if messages|length > 1 %}
        <ul class="list-disc ps-5">
          {% for message in messages %}
            <li>{{ message }}</li>
          {% endfor %}
        </ul>
      {% else %}
        {{ messages|first }}
      {% endif %}
    </div>
  {% endfor %}
</div>
