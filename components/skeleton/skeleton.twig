{% if variant == 'card' %}
  <div{{ attributes.addClass('flex', 'flex-col', 'gap-4') }}>
    <div class="skeleton h-40 w-full rounded-2xl"></div>
    <div class="skeleton skeleton-text h-4 w-1/3"></div>
    <div class="skeleton skeleton-text h-6 w-2/3"></div>
    <div class="skeleton skeleton-text h-4 w-full"></div>
  </div>
{% elseif variant == 'text' %}
  <div{{ attributes.addClass('skeleton', 'skeleton-text', height|default('h-4'), width|default('w-full')) }}></div>
{% else %}
  <div{{ attributes.addClass('skeleton', height|default('h-4'), width|default('w-full')) }}></div>
{% endif %}
