{% if items %}
  <div{{ attributes.addClass('stats', 'w-full', 'bg-transparent', 'shadow-none', direction == 'vertical' ? 'stats-vertical' : 'stats-horizontal') }}>
    {% for item in items %}
      <div class="stat border-l-4 border-cta px-4">
        {% if item.value %}
          <div class="stat-value font-display text-5xl font-normal text-primary md:text-6xl">{{ item.value }}</div>
        {% endif %}

        {% if item.title %}
          <div class="stat-title text-sm font-semibold uppercase tracking-wider text-base-content/60">{{ item.title }}</div>
        {% endif %}

        {% if item.description %}
          <div class="stat-desc">{{ item.description }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
